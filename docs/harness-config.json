{
  "version": 1,
  "paths": {
    "stateFile": "docs/harness-state.json",
    "memoryFile": "docs/project-memory.md",
    "decisionsFile": "docs/decisions.md",
    "contractsDir": "docs/contracts"
  },
  "commands": {
    "verifyQuick": "python3 -m py_compile runtime/scripts/*.py && python3 -m unittest discover -s runtime/tests -v && zsh -n tools/deploy_skills_to_codex.sh",
    "verifyFull": "python3 -m unittest discover -s runtime/tests -v && ./tools/deploy_skills_to_codex.sh --check",
    "docsGenerate": ""
  },
  "rules": {
    "maxRepeatedFailures": 2
  }
}
